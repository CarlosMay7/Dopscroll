<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Doomscroll</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Core unit tests are a separate project (Tests/Doomscroll.Core.Tests); keep them out of the game build. -->
    <Compile Remove="Tests/**" />
  </ItemGroup>

</Project>
